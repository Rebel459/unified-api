{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "A multiloader API built to enable easy cross-loader mod development\n\n",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Rebel459/unified-api"
  },
  "license": "LGPL 3.0-Only",
  "icon": "assets/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rebel459.unified.UnifiedFabric"
    ],
    "client": [
      "net.rebel459.unified.UnifiedFabricClient"
    ]
  },
  "mixins": [
    "unified.mixins.json",
    "unified-fabric.mixins.json"
  ],
  "accessWidener": "unified.classtweaker",
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": "*",
    "minecraft": ">=1.21.11",
    "java": ">=21"
  }
}