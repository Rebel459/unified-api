{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}-fabric",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Rebel459/unified-api"
  },
  "license": "${license}",
  "icon": "assets/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rebel459.unified.UnifiedFabric"
    ],
    "client": [
      "net.rebel459.unified.UnifiedFabricClient"
    ],
    "fabric-datagen": [
      "net.rebel459.unified.datagen.FabricUnifiedDatagen"
    ]
  },
  "mixins": [
    "unified.mixins.json",
    "unified-fabric.mixins.json"
  ],
  "accessWidener": "unified.classtweaker",
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version}",
    "java": ">=21"
  }
}
