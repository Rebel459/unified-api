    "main": [
      "net.rebel459.unified.UnifiedFabric"
    ]
  },
  "mixins": [
    "unified.mixins.json",
    "unified-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18",
    "fabric": "*",
    "minecraft": ">=1.21.11",
    "java": ">=21"
  }
