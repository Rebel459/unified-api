  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/fabricmc/"
  },
  "license": "MIT",
  "icon": "assets/examplemod/icon.png",
  "environment": "*",
